# MinIO Bucket
MINIO_SECRET_KEY=
MINIO_ACCESS_KEY=
MINIO_BUCKET=machtia # Recommended

# == PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=machtia # Recommended
POSTGRES_HOST=database:5432 # Left if you are going to use the database inside the container
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}
